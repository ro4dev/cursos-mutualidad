{
  "name": "cursos-mutualidad",
  "version": "0.1.0",
  "private": true,
  "description": "Catalogo de cursos de mutualidad en espanol de Chile, compuestos como video con HyperFrames",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "catalog:check": "node scripts/validate-courses.mjs",
    "catalog:build": "node scripts/validate-courses.mjs && node scripts/build-catalog.mjs",
    "course:gen": "node scripts/gen-courses.mjs",
    "frames:check": "node scripts/check-selectors.mjs",
    "video:build": "node scripts/render-all.mjs",
    "video:render": "node scripts/render-all.mjs",
    "check": "npm run catalog:check && node scripts/check-selectors.mjs && npm run catalog:build"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@hyperframes/player": "0.8.78",
    "hyperframes": "0.8.78",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
